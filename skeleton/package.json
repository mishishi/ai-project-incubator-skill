{
  "name": "{project-name}",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npx tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "rm -rf /usr/share/nginx/html/{project-name} && mkdir -p /usr/share/nginx/html/{project-name}/assets && cp dist/index.html /usr/share/nginx/html/{project-name}/index.html && cp dist/assets/* /usr/share/nginx/html/{project-name}/assets/"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.15.0",
    "lucide-react": "^1.16.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "typescript": "~5.7.0",
    "vite": "^7.0.0"
  }
}